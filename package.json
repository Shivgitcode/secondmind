{
  "name": "secondmind",
  "version": "0.1.0",
  "description": "Shared memory for AI coding sessions. Stop re-explaining what you already figured out.",
  "type": "module",
  "bin": {
    "secondmind": "dist/src/cli/index.js"
  },
  "files": [
    "dist/src",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/src/cli/index.js",
    "test": "npm run build && node --test dist/test/*.test.js",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
